[Unit]
Description=LibreScoot Uplink Service (Redis-IPC)
After=network.target redis.service
Requires=redis.service
ConditionPathExists=/data/uplink-service/uplink.yaml

[Service]
Type=simple
WorkingDirectory=/data/uplink-service
ExecStartPre=/bin/mkdir -p /data/uplink-service
ExecStart=/usr/bin/uplink-service -config /data/uplink-service/uplink.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
