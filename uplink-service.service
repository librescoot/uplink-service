[Unit]
Description=LibreScoot Uplink Service
After=network-online.target librescoot-onboot.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /data/uplink-service
ExecStart=/data/uplink-service -config /data/uplink-service/uplink.yaml
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
